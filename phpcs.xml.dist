<?xml version="1.0"?>
<!--
PHPCS-Konfiguration für MomentumLab SEO.
Aufruf: vendor/bin/phpcs  (oder phpcs, wenn global installiert)
-->
<ruleset name="mlab-seo">
	<description>WordPress Coding Standards für mlab-seo.</description>

	<file>.</file>
	<exclude-pattern>lib/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>languages/*</exclude-pattern>

	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg name="parallel" value="8" />

	<config name="testVersion" value="8.0-" />
	<config name="minimum_supported_wp_version" value="6.5" />

	<rule ref="WordPress" />
	<rule ref="PHPCompatibilityWP" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="mlab-seo" />
		</properties>
	</rule>
</ruleset>
